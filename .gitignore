# OS / editor cruft
.DS_Store
Thumbs.db
*.iml

# Android build output & machine-specific config for the buildable project in android/.
# (android/.gitignore also covers these; listed here too so a clone from the repo root
#  never accidentally stages build artifacts or your local SDK path.)
android/local.properties
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/captures/
android/.idea/

# Desktop Anki add-on: local state (downloaded audio, Anki's per-install config) and bytecode.
desktop/ankiaudio/user_files/
desktop/ankiaudio/meta.json
__pycache__/
